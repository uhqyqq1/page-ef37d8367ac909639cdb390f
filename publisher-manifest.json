;margin-bottom:12px}\n.cli p{font-size:13px;color:#5a4a3a;margin:0 0 14px}\n.cli .dl{font-size:13px;color:#2f6f5e;font-weight:600}\n.cli .dl::after{content:\" →\"}\n\n/* FAQ details 折叠 */\n.faq-list{display:grid;gap:12px;max-width:820px}\n.faq-list details{background:#f4ece1;padding:0 22px;border:1px solid #d8c8b0;transition:border-color .2s}\n.faq-list details[open]{border-color:#2f6f5e;background:#f9f2e6}\n.faq-list summary{cursor:pointer;padding:18px 0;font-size:15px;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;color:#3a2418}\n.faq-list summary::-webkit-details-marker{display:none}\n.faq-list summary::after{content:\"+\";font-size:22px;color:#2f6f5e;transition:transform .2s;font-weight:400}\n.faq-list details[open] summary::after{content:\"−\"}\n.faq-list .answer{padding:0 0 20px;font-size:14px;color:#5a4a3a;border-top:1px dashed #c8b8a0;padding-top:14px}\n\n/* 底部 */\n.foot{background:#2b1a10;color:#d8c8b0;padding:36px 0;font-size:13px}\n.foot .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px;align-items:center}\n.foot nav{display:flex;gap:18px;flex-wrap:wrap}\n.foot a{color:#a8d8c5;border-bottom-color:rgba(168,216,197,.3)}\n\n@media (max-width:860px){\n.hero{padding:48px 0 56px}\n.hero .wrap{grid-template-columns:1fr;gap:36px}\n.hero h1{font-size:38px}\n.spec-strip{grid-template-columns:repeat(3,1fr);max-width:none}\n.card-row{grid-template-columns:1fr}\n.steps{grid-template-columns:1fr}\n.step{border-right:none;border-bottom:1px solid #5a3a26}\n.step:last-child{border-bottom:none}\n.cli-grid{grid-template-columns:repeat(2,1fr)}\n.plan{grid-template-columns:1fr}\n.plan .right ul{grid-template-columns:1fr}\n.section-head h2{font-size:26px}\n}\n@media (max-width:480px){\n.cli-grid{grid-template-columns:1fr}\n.spec-strip{grid-template-columns:1fr 1fr}\n.crumbs nav{margin-left:0;width:100%;padding-top:6px}\n}\n</style><header class=\"crumbs\" role=\"banner\">\n<div class=\"wrap\">\n<span>首页</span><span>/</span><a href=\"#plans\">订阅套餐</a><span>/</span><a href=\"#clients\">客户端下载</a><span>/</span><a href=\"#faq\">常见问题</a>\n<nav aria-label=\"页面目录\">\n<a href=\"#about\">关于小火龙</a>\n<a href=\"#how\">使用方法</a>\n<a href=\"#plans\">套餐</a>\n<a href=\"#clients\">客户端</a>\n<a href=\"#faq\">问答</a>\n</nav>\n</div>\n</header>\n\n<main>\n\n<section class=\"hero\" id=\"top\">\n<div class=\"wrap\">\n<div class=\"hero-left\">\n<span class=\"eyebrow\">节点订阅服务</span>\n<h1 id=\"brand-h1\">小火龙<em>·</em>把你的网络线路交给一只温和的小火龙</h1>\n<p class=\"lede\">小火龙面向个人开发者、远程办公者与小团队,提供可订阅的节点与配套客户端。本页集中呈现订阅档位、客户端下载与购买前后可能遇到的问题,你可以先通读,再决定是否开始试用。</p>\n<div class=\"cta-row\">\n<a class=\"btn btn-primary\" href=\"#plans\">查看三档订阅</a>\n<a class=\"btn btn-ghost\" href=\"#how\">了解使用方法</a>\n</div>\n<div class=\"spec-strip\" aria-label=\"服务速览\">\n<div>订阅档位<b>3 档</b></div>\n<div>客户端<b>4 平台</b></div>\n<div>计费方式<b>月付 / 年付</b></div>\n</div>\n</div>\n<aside class=\"info-panel\" aria-label=\"购买前速览\">\n<h3>购买前速览</h3>\n<p class=\"panel-title\">订阅开通后,你会拿到什么?</p>\n<ul>\n<li><span>订阅链接</span><span>开通即发</span></li>\n<li><span>客户端</span><span>4 平台</span></li>\n<li><span>流量起算</span><span>开通日</span></li>\n<li><span>工单回复</span><span>工作时段</span></li>\n<li><span>续费方式</span><span>原通道续订</span></li>\n</ul>\n<div class=\"panel-note\">提示:本页价格为示例档位,实际付款以你下单时的页面显示为准。</div>\n</aside>\n</div>\n</section>\n\n<section id=\"about\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div class=\"kicker\">关于小火龙</div>\n<h2 id=\"about-h2\">一只在节点之间来回穿行的小火龙</h2>\n<p>小火龙把节点、订阅链接和客户端收拢到一个简洁的工作流里:你选档位,拿到链接,导入客户端,然后像往常一样打开应用。下面三个区块,分别讲清楚它是什么、怎么用,以及常见疑问。</p>\n</div>\n<div class=\"cards\">\n<div class=\"card-row\">\n<article class=\"card\">\n<span class=\"num\">01</span>\n<div class=\"content\">\n<h3>它解决什么问题</h3>\n<p>当你需要稳定地接入自有节点,或在不同设备间复用同一份订阅时,小火龙把节点信息和客户端解耦,只负责把链接送到你手里。</p>\n</div>\n</article>\n<article class=\"card\">\n<span class=\"num\">02</span>\n<div class=\"content\">\n<h3>它适合谁</h3>\n<p>适合自购节点后希望统一管理订阅的个人用户,以及成员不多的远程小组。暂不提供面向大企业的私有化部署。</p>\n</div>\n</article>\n<article class=\"card\">\n<span class=\"num\">03</span>\n<div class=\"content\">\n<h3>它不做什么</h3>\n<p>不承诺\"一键加速\"、\"全网最低延迟\",也不做节点跑分排行;你需要根据自己常用的应用,自行选择线路与档位。</p>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>\n\n<section id=\"how\" class=\"alt\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div class=\"kicker\">使用方法</div>\n<h2 id=\"how-h2\">从下单到第一次握手,只需要三步</h2>\n<p>下面的步骤不绑定具体客户端,如果你已经在用某个支持订阅链接的工具,通常也可以直接复用。</p>\n</div>\n<div class=\"steps\">\n<div class=\"step\">\n<div class=\"sn\">STEP 01</div>\n<h4>选档位并完成下单</h4>\n<p>在下方\"订阅套餐\"区挑选适合的档位,按月或按年付款,下单后系统会生成一条订阅链接。</p>\n</div>\n<div class=\"step\">\n<div class=\"sn\">STEP 02</div>\n<h4>下载对应客户端</h4>\n<p>前往\"客户端下载\"区,按你的系统选择对应版本,安装后打开,在订阅管理中粘贴上一步得到的链接。</p>\n</div>\n<div class=\"step\">\n<div class=\"sn\">STEP 03</div>\n<h4>更新订阅并连接</h4>\n<p>客户端会拉取节点列表,选择延迟合适的节点,开启连接即可。如果某节点不通,先尝试更新订阅再切换。</p>\n</div>\n</div>\n</div>\n</section>\n\n<section id=\"plans\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div class=\"kicker\">订阅套餐</div>\n<h2 id=\"plans-h2\">三档订阅,差异在流量、设备数与节点池</h2>\n<p>下列价格为当前档位示例,具体以你下单时页面显示为准;按年付相比按月付会节省两个月费用,适合稳定使用的用户。</p>\n</div>\n<div class=\"plans\">\n\n<article class=\"plan\" aria-label=\"基础版套餐\">\n<div class=\"left\">\n<div class=\"plan-name\">基础版</div>\n<div class=\"plan-title\">个人轻度使用</div>\n<div class=\"price\">¥15<small>/月</small></div>\n<div class=\"annual\">按年付仅需 ¥150/年</div>\n</div>\n<div class=\"right\">\n<h4>包含权益</h4>\n<ul>\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n</div>\n</article>\n\n<article class=\"plan featured\" aria-label=\"旗舰版套餐,推荐\">\n<div class=\"left\">\n<div class=\"plan-name\">旗舰版</div>\n<div class=\"plan-title\">多数人的稳妥选择</div>\n<div class=\"price\">¥35<small>/月</small></div>\n<div class=\"annual\">按年付仅需 ¥350/年</div>\n<span class=\"tag\">推荐</span>\n</div>\n<div class=\"right\">\n<h4>包含权益</h4>\n<ul>\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7x24 优先工单支持</li>\n</ul>\n</div>\n</article>\n\n<article class=\"plan\" aria-label=\"团队版套餐\">\n<div class=\"left\">\n<div class=\"plan-name\">团队版</div>\n<div class=\"plan-title\">小团队与重度用户</div>\n<div class=\"price\">¥85<small>/月</small></div>\n<div class=\"annual\">按年付仅需 ¥850/年</div>\n</div>\n<div class=\"right\">\n<h4>包含权益</h4>\n<ul>\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n</div>\n</article>\n\n</div>\n</div>\n</section>\n\n<section id=\"clients\" class=\"alt\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div class=\"kicker\">客户端下载</div>\n<h2 id=\"clients-h2\">覆盖常见平台,本地与便携版都可用</h2>\n<p>下载前请按你的操作系统选择对应版本;若你的设备不在列表内,可以使用任何兼容订阅链接的通用客户端。</p>\n</div>\n<div class=\"cli-grid\">\n<article class=\"cli\">\n<h4>Windows</h4>\n<div class=\"os\">Win 10 / 11 · x64</div>\n<p>桌面客户端,支持订阅链接导入与系统代理模式切换,适合长时间挂机的使用场景。</p>\n<a class=\"dl\" href=\"#\">下载 Windows 版</a>\n</article>\n<article class=\"cli\">\n<h4>macOS</h4>\n<div class=\"os\">macOS 12+ · Apple Silicon / Intel</div>\n<p>为 Mac 优化的客户端,支持菜单栏快捷开关与按应用分流配置,适合办公本与家用机。</p>\n<a class=\"dl\" href=\"#\">下载 macOS 版</a>\n</article>\n<article class=\"cli\">\n<h4>iOS</h4>\n<div class=\"os\">iPhone / iPad · iOS 15+</div>\n<p>移动端客户端,提供按需连接与全局模式,首次使用需要在系统中添加信任的配置描述文件。</p>\n<a class=\"dl\" href=\"#\">前往 App Store</a>\n</article>\n<article class=\"cli\">\n<h4>Android</h4>\n<div class=\"os\">Android 8.0+ · arm64</div>\n<p>Android 客户端,支持分应用代理与扫码导入订阅,适合在手机上同时管理多个订阅。</p>\n<a class=\"dl\" href=\"#\">下载 Android 版</a>\n</article>\n</div>\n</div>\n</section>\n\n<section id=\"faq\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div class=\"kicker\">常见问题</div>\n<h2 id=\"faq-h2\">购买前后,大家常问的 6 个问题</h2>\n<p>如果你遇到的问题没有在下面列出,可以在购买后通过工单联系我们,工作时段内会尽量当天回复。</p>\n</div>\n<div class=\"faq-list\">\n\n<details>\n<summary>小火龙到底是什么?它提供\"翻墙\"或\"VPN\"服务吗?</summary>\n<div class=\"answer\">小火龙是一套节点订阅与客户端管理工具:你购买的是一档订阅以及对应的客户端使用权限。我们不对外宣传任何\"翻墙\"\"VPN\"等表述,具体节点用途请以你所在地区的法律法规为准。</div>\n</details>\n\n<details>\n<summary>我应该选哪一档订阅?</summary>\n<div class=\"answer\">如果你只是偶尔使用、且设备数在两到三台,基础版通常够用;如果你需要同时跑多台设备,或者常用流媒体,建议直接选旗舰版;团队版面向多人共用或对节点带宽有较高要求的场景。</div>\n</details>\n\n<details>\n<summary>下单后多久能拿到订阅链接?</summary>\n<div class=\"answer\">支付成功后,系统会自动生成订阅链接并发送至你下单时填写的邮箱,通常几分钟内就会到达;如果超过 15 分钟仍未收到,可以在客户端下载页提交工单查询。</div>\n</details>\n\n<details>\n<summary>支持哪些设备和客户端?</summary>\n<div class=\"answer\">目前官方客户端覆盖 Windows、macOS、iOS 与 Android 四个平台。如果你已经在使用兼容订阅链接的第三方工具,也可以直接粘贴链接复用,不必切换到我们的客户端。</div>\n</details>\n\n<details>\n<summary>订阅到期后,节点会立刻失效吗?</summary>\n<div class=\"answer\">订阅到期后,客户端在下一次更新订阅时会拉取不到新信息,导致无法继续连接,但你的账号与历史数据会保留一段时间。续费成功后,无需重新导入订阅链接,直接更新订阅即可恢复。</div>\n</details>\n\n<details>\n<summary>如何申请退款或变更档位?</summary>\n<div class=\"answer\">开通后短期内如有变更档位或退款需求,可以在工单中说明下单号与原因,工作时段内会按订单实际情况评估处理。请注意,已大量使用的流量可能影响最终可退金额。</div>\n</details>\n\n</div>\n</div>\n</section>\n\n</main>\n\n<footer class=\"foot\" role=\"contentinfo\">\n<div class=\"wrap\">\n<div>© 小火龙 · 节点订阅与客户端服务</div>\n<nav aria-label=\"页脚导航\">\n<a href=\"#top\">回到顶部</a>\n<a href=\"#plans\">订阅套餐</a>\n<a href=\"#clients\">客户端</a>\n<a href=\"#faq\">常见问题</a>\n</nav>\n</div>\n</footer>",
